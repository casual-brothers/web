# ── Casual Brothers — Next.js Static Export ──────────
# Configuración Apache para servir correctamente el export estático de Next.js

# Disable directory listing
Options -Indexes

# Enable rewrite engine
RewriteEngine On
RewriteBase /

# ── Canonical locale redirects ───────────────────────
# Search Console still sees legacy/non-localized paths. Send them to the
# English x-default versions with a single 301 hop.
RewriteRule ^$ /en [R=301,L]
RewriteRule ^(games|services|game-development-company|publishers|game-development-services|co-development-game-studio|console-porting-services|licensed-ip-game-development|unity-game-development-studio|case-studies|resources|about|careers|contact|privacy-policy|cookie-policy|legal-notice)/?$ /en/$1 [R=301,L]
RewriteRule ^case-studies/(.+)/?$ /en/case-studies/$1 [R=301,L]
RewriteRule ^juegos/?$ /es/games [R=301,L]
RewriteRule ^servicios/?$ /es/services [R=301,L]
RewriteRule ^estudio/?$ /es/about [R=301,L]
RewriteRule ^empleo/?$ /es/careers [R=301,L]
RewriteRule ^contacto/?$ /es/contact [R=301,L]

# ── Clean URLs ───────────────────────────────────────
# If request matches a directory AND a sibling .html file exists, serve the .html
# This handles: /en → /en.html, /en/about → /en/about.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# ── LiteSpeed Cache Disable ──────────────────────────
# Prevents LiteSpeed server-side cache from serving stale HTML/assets
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# ── Caching ──────────────────────────────────────────
# Cache largo para assets inmutables (JS, CSS, fonts con hash en nombre)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"
</IfModule>

# Force revalidation for HTML, TXT, XML, and JSON files to prevent stale caching
<FilesMatch "\.(html|htm|txt|xml|json)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>

# ── MIME types ───────────────────────────────────────
# Asegurar que los modelos 3D se sirven correctamente
AddType model/gltf-binary .glb
AddType font/woff2 .woff2

# ── Compression ──────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Security Headers ─────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
