		<style id="wp-custom-css">
			html,
body {
  max-width: 100% !important;
  overflow-x: hidden !important;
}

html {
  scroll-behavior: smooth;
}

h1.entry-title {
  display: none !important;
}

* {
  text-decoration: none !important;
}

*:focus,
*:focus-visible {
  outline: none !important;
	box-shadow: none !important;
}

.coreconcepts a {
  color: #131313;
  font-weight: 600;
}

.coreconcepts a:hover {
  color: #374028;
}

/*/===============================*/
/*/////SCROLLBAR////*/
/*/===============================*/
body::-webkit-scrollbar {
  width: 12px; /* width of the entire scrollbar */
}

body::-webkit-scrollbar-track {
  background: #ffffff; /* color of the tracking area */
}

body::-webkit-scrollbar-thumb {
  background-color: #888888; /* color of the scroll thumb */
  border-radius: 20px; /* roundness of the scroll thumb */
  border: 3px solid white; /* creates padding around scroll thumb */
}
/*/===============================*/
/*/////SCROLLBAR////*/
/*/===============================*/

.bg_image {
  background-image: url("https://casualbrothers.com/wp-content/uploads/bbblurry.svg") !important;

  background-position: center center !important;

  background-repeat: no-repeat !important;

  background-attachment: fixed !important;

  background-size: cover !important;
}


.gameCon:hover .gameLogo {
     transform: scale(0.87);
}

.logoHero img {
  aspect-ratio: 5/2;
  width: 150px;
  object-fit: contain;
}

/*===============================*/
/*////TABS ELEMENT RESPONSIVE ON MOBILE////*/
/*!!!!!!!!!!!!!!!*/
/*DO NOT FORGET TO GIVE THE Tabs Elements the classname `tabs-title-buttons`*/
/*===============================*/

  .tabs-title-buttons .e-n-tabs .e-n-tabs-heading {
    display: flex !important;
    flex-direction: row !important;
    justify-content: center;
    flex-wrap: no-wrap !important;
  }

  .elementor-widget-n-tabs .e-n-tabs-heading {
    gap: 0 !important;
  }

  .tabs-title-buttons .e-n-tabs .e-n-tabs-heading button {
    margin: 5px !important;
    padding: 10px;
    border-radius: 50px;
  }

@media (max-width: 1024px) {
  .tabs-title-buttons .e-n-tabs .e-n-tabs-heading {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center;
    flex-wrap: no-wrap !important;
  }

  .elementor-widget-n-tabs .e-n-tabs-heading {
    gap: 0 !important;
  }

  .tabs-title-buttons .e-n-tabs .e-n-tabs-heading button {
    margin: 5px !important;
    padding: 10px;
  }
}

@media (max-width: 1024px) {
  .elementor-widget-n-tabs .e-n-tabs-heading {
    gap: 0 !important;
  }
}
/*===============================*/
/*////TABS ELEMENT RESPONSIVE ON MOBILE////*/
/*===============================*/		</style>
